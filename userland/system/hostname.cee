// hostname.cee - print the machine's name, or set it: hostname [name]. The first whole user program in CeeSafe
// (roadmap 1.3 R2, the CeeSafe rule's offset for R2's C): the C it replaced, line for line in behaviour.
//
// The name comes from the caller's uts namespace, so a process started with a namespace of its own prints its
// container's name rather than the host's (docs/kernel/security/design.md §1e).

@header("unistd.h", "string.h", "stdio.h")
extern "C" {
    @effects()
    fn strlen(s: *CChar) -> usize;
    fn sethostname(name: *CChar, len: usize) -> i32;
    fn gethostname(name: *mut CChar, len: usize) -> i32;
    fn perror(s: *CChar);
    fn puts(s: *CChar) -> i32;
    fn write(fd: i32, buf: *void, n: usize) -> isize;
    @cvalue("HOST_NAME_MAX")
    const HOST_NAME_MAX: usize = 64;
}

/// Safety: `argv` holds `argc` strings.
@export("cosmo_program_main") // crt0 calls main: the link names this main (userland.mk, PROG_MAIN_<name>)
unsafe fn run(argc: i32, argv: *mut *mut CChar) -> i32 {
    if (argc > 2) {
        let usage = "usage: hostname [name]\n";
        let _ = write(2, usage.ptr as *void, usage.length);
        return 2;
    }
    if (argc == 2) {
        let name = argv.add(1).read() as *CChar;
        if (sethostname(name, strlen(name)) < 0) {
            perror("hostname\0".ptr as *CChar);
            return 1;
        }
        return 0;
    }
    var name = [0u8; HOST_NAME_MAX];
    if (gethostname(borrow mut name as *mut [u8; HOST_NAME_MAX] as *mut CChar, HOST_NAME_MAX) < 0) {
        perror("hostname\0".ptr as *CChar);
        return 1;
    }
    let _ = puts(borrow name as *[u8; HOST_NAME_MAX] as *CChar);
    return 0;
}
